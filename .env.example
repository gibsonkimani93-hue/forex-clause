# Forex Clause configuration
PORT=3000

# Keep your OpenAI API key ONLY on the server. Never put it in index.html.
OPENAI_API_KEY=

# Free users get unlimited basic AI answers.
# Premium users get the deeper AI mode.
FREE_AI_MODEL=gpt-5.6-luna
PREMIUM_AI_MODEL=gpt-5.6-sol

# Temporary local testing switch only. Leave false on a public deployment.
PREMIUM_DEMO=true
